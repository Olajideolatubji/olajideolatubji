# ---------------------------------------------------------------------- core
OPERATOR_PASSWORD=change-me
SECRET_KEY=generate-a-long-random-string
API_PORT=8000
LOG_LEVEL=INFO
STORAGE_ROOT=/data
DATABASE_URL=postgresql+psycopg://vvs:vvs@postgres:5432/vvs
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=vvs
POSTGRES_PASSWORD=vvs
POSTGRES_DB=vvs
WORKER_CONCURRENCY=4

# composition = HeyGen renders whole segments. beats = local ComfyUI per beat.
RENDER_MODE=composition

# -------------------------------------------------------------------- heygen
HEYGEN_API_KEY=
HEYGEN_MODE=template
HEYGEN_TEMPLATE_ID=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
# Watermarked renders that do not consume credits. Leave true until you mean it.
HEYGEN_TEST=true
HEYGEN_POLL_SECONDS=20
HEYGEN_MAX_POLL_MINUTES=90
# THE constraint: your plan's per-video duration cap, in seconds. The planner
# splits anything longer into this many-second segments automatically.
HEYGEN_MAX_SEGMENT_SECONDS=300
HEYGEN_DIMENSION_WIDTH=1080
HEYGEN_DIMENSION_HEIGHT=1920
HEYGEN_PLACEHOLDER_SCRIPT=script
HEYGEN_PLACEHOLDER_TITLE=title
HEYGEN_PLACEHOLDER_BACKGROUND=background

# Optional per-step provider chain override (first is primary, rest are failover)
# PROVIDER_CHAINS={"segment_render":["heygen","heygen_agent"]}

# ------------------------------------------------------------------- comfyui
COMFYUI_URL=http://comfyui:8188
COMFYUI_IMAGE_WORKFLOW=/srv/workflows/image.json
COMFYUI_VIDEO_WORKFLOW=/srv/workflows/image_to_video.json
COMFYUI_POLL_SECONDS=5
COMFYUI_TIMEOUT_SECONDS=900
COMFYUI_REFERENCE_DIR=/data/references

# ----------------------------------------------------------------------- tts
# heygen = the renderer speaks; elevenlabs = local per-beat narration; none = silence
TTS_PROVIDER=heygen
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
TTS_MAX_CHARS_PER_CALL=900

# -------------------------------------------------------------------- ffmpeg
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CRF=19
VIDEO_PRESET=medium
AUDIO_BITRATE=192k
# Audio crossfade at every segment seam, clamped to 200-400ms.
SEAM_CROSSFADE_MS=300
FFMPEG_MAX_JOIN_INPUTS=8
COLOR_GRADE_FILTER=eq=contrast=1.05:saturation=1.08:gamma=0.98
BURN_CAPTIONS=true

# ---------------------------------------------------------------------- cost
COST_PER_RENDER_MINUTE_USD=0.30
COST_PER_SEGMENT_USD=0.0
COST_PER_TTS_1K_CHARS_USD=0.18
STORAGE_COST_PER_GB_MONTH_USD=0.02
MONTHLY_COST_CAP_USD=200
LONG_TIER_REQUIRES_CONFIRMATION=true

# --------------------------------------------------------------------- queue
MAX_CONCURRENT_SEGMENT_JOBS=3
MAX_RETRIES=4
RETRY_BACKOFF_SECONDS=20
RETRY_BACKOFF_MAX_SECONDS=900
RESUME_SWEEP_SECONDS=60

# ----------------------------------------------------------------- long form
MAX_EXPENSIVE_BEATS_PER_CHAPTER=2
PLATE_POOL_PER_CHAPTER=4
LOOPABLE_MIN_SECONDS=20
PRUNE_SUPERSEDED_TAKES=true
