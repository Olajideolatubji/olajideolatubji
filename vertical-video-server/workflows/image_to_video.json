{
  "_comment": "ComfyUI API-format graph turning one beat still into motion. Tokens {{input_image}} {{width}} {{height}} {{frames}} {{fps}} {{seed}} {{beat_id}} are substituted by app/providers/comfyui.py. Node 6 needs ComfyUI-VideoHelperSuite (VHS_VideoCombine) to emit an MP4 the server can download.",
  "1": {
    "class_type": "ImageOnlyCheckpointLoader",
    "inputs": { "ckpt_name": "svd_xt.safetensors" }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{input_image}}" }
  },
  "3": {
    "class_type": "SVD_img2vid_Conditioning",
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "video_frames": "{{frames}}",
      "motion_bucket_id": 110,
      "fps": "{{fps}}",
      "augmentation_level": 0.0,
      "clip_vision": ["1", 1],
      "init_image": ["2", 0],
      "vae": ["1", 2]
    }
  },
  "4": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{seed}}",
      "steps": 25,
      "cfg": 2.5,
      "sampler_name": "euler",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["1", 0],
      "positive": ["3", 0],
      "negative": ["3", 1],
      "latent_image": ["3", 2]
    }
  },
  "5": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["4", 0], "vae": ["1", 2] }
  },
  "6": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["5", 0],
      "frame_rate": "{{fps}}",
      "loop_count": 0,
      "filename_prefix": "vvs/{{beat_id}}",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    }
  }
}
